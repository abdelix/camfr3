# This Python script contains all the machine dependent settings
# needed during the build process.
#
# Template for Linux with Python 3, GCC/gfortran, Blitz++, BLAS/LAPACK and
# Boost.Python. Copy it to machine_cfg.py before building:
#
#     cp machine_cfg.py.linux machine_cfg.py
#
# Python and NumPy locations are detected from the interpreter that runs the
# build. Boost is searched in /usr by default; set BOOST_ROOT to use a
# different prefix, e.g. one unpacked from the Ubuntu .deb packages:
#
#     BOOST_ROOT=/path/to/boost-root/usr scons

import os
import sysconfig

import numpy

# Compilers to be used.

cc  = "gcc"
cxx = "g++"
f77 = "gfortran"

# Compiler flags.
#
# Note: for the Fortran name definition you can define one of the following
#       preprocessor macros:
#
#           FORTRAN_SYMBOLS_WITHOUT_TRAILING_UNDERSCORES
#           FORTRAN_SYMBOLS_WITH_SINGLE_TRAILING_UNDERSCORE
#           FORTRAN_SYMBOLS_WITH_DOUBLE_TRAILING_UNDERSCORES

base_flags = "-DFORTRAN_SYMBOLS_WITH_SINGLE_TRAILING_UNDERSCORE -DNDEBUG "

flags_noopt = base_flags

flags = base_flags + "-O3 "

fflags = "-O3 "  # SCons adds -fPIC for shared objects

# Python, NumPy and Boost locations.

python_version = sysconfig.get_config_var("py_version_nodot")  # e.g. "314"

boost_root = os.environ.get("BOOST_ROOT", "/usr")
boost_libdirs = [d for d in (os.path.join(boost_root, "lib", "x86_64-linux-gnu"),
                             os.path.join(boost_root, "lib"))
                 if os.path.isdir(d)]

# Include directories.

include_dirs = [sysconfig.get_paths()["include"],
                numpy.get_include(),
                os.path.join(boost_root, "include")]

# Library directories.

library_dirs = boost_libdirs

# Linker. Embed an rpath when Boost lives outside the system prefix so that
# _camfr.so finds libboost_python at import time.

link = cxx
link_flags = ""
if boost_root != "/usr":
  link_flags += " ".join("-Wl,-rpath," + d for d in boost_libdirs)

# Library names.

libs = ["boost_python" + python_version, "blitz", "lapack", "blas", "gfortran"]

# Command to strip library of excess symbols:

dllsuffix = ".so"
strip_command = ""

# Extra files to copy into installation directory.

extra_files = []
